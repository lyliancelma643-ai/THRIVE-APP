# THRIVE mobile — variables d'environnement (copier en .env, jamais committé).
# Les EXPO_PUBLIC_* sont INLINÉES dans le bundle JS : n'y mettre que des valeurs
# publiques (clés anon/publishables). En build EAS, les poser dans les variables
# d'environnement EAS (development / preview / production), pas dans eas.json.

# --- Config Expo / EAS (lue par app.config.ts, non embarquée telle quelle) ---
# UUID du projet EAS (expo.dev > Project settings). Requis pour le token push
# Expo hors build EAS. Absent = clé extra.eas.projectId omise.
EAS_PROJECT_ID=

# --- Supabase (packages/shared/src/lib/supabase.ts) ---
# URL du projet Supabase de prod THRIVE-CA (https://<ref>.supabase.co).
EXPO_PUBLIC_SUPABASE_URL=
# Clé anon/publishable (publique, protégée par RLS). Jamais la service_role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Web / pages légales (src/services/legal.ts, src/app/(parent)/bilans.tsx) ---
# Origine de l'app web (défaut : https://app.thrivesportpositive.com).
EXPO_PUBLIC_WEB_URL=
# Conditions d'utilisation (défaut : <web>/conditions).
EXPO_PUBLIC_TERMS_URL=
# Politique de confidentialité (défaut : <web>/confidentialite).
EXPO_PUBLIC_PRIVACY_URL=
# Page d'aide / support (défaut : <web>/support).
EXPO_PUBLIC_SUPPORT_URL=

# --- Abonnements RevenueCat (src/services/purchases.ts) ---
# Clé SDK publique iOS (appl_…). Vide = achats désactivés sur iOS.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# Clé SDK publique Android (goog_…). Vide = achats désactivés sur Android.
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# --- Observabilité Sentry (src/lib/sentry.ts) ---
# DSN Sentry du projet thrive-mobile (public). Vide = Sentry inerte.
EXPO_PUBLIC_SENTRY_DSN=
# Environnement Sentry (development | preview | production) ; posé par eas.json.
EXPO_PUBLIC_APP_ENV=

# --- Build uniquement (secret EAS, JAMAIS en EXPO_PUBLIC_ ni dans ce fichier) ---
# SENTRY_AUTH_TOKEN : upload des sourcemaps par le plugin @sentry/react-native/expo.
# SENTRY_ORG : organisation Sentry (le plugin a project=thrive-mobile).
