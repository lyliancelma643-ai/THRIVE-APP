+/* ─── Cartes « À la maison » (onglet Fitness) ─────────────────────────────────
+   Mêmes principes que Nuit calme — pas de halo, un effet à la fois — avec les
+   gestes propres à un jeu de cartes : l'écran suivant glisse, une étape cochée
+   rebondit, une carte faite reçoit son tampon, le silence se compte en points. */
+.hc-slide {
+  animation: hc-slide 0.42s cubic-bezier(0.22, 0.61, 0.36, 1) both;
+}
+.hc-pop {
+  animation: hc-pop 0.34s cubic-bezier(0.34, 1.56, 0.64, 1) both;
+}
+.hc-stamp {
+  animation: hc-stamp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both 0.25s;
+}
+.hc-expand {
+  animation: om-fade 0.35s ease both;
+}
+/* Carrousel : la carte au centre est pleine, ses voisines reculent */
+.hc-deck-card {
+  transition:
+    transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
+    opacity 0.35s ease;
+}
+.hc-deck-card[data-active='false'] {
+  transform: scale(0.94);
+  opacity: 0.55;
+}
+@keyframes hc-slide {
+  from {
+    opacity: 0;
+    transform: translateX(28px);
+  }
+  to {
+    opacity: 1;
+    transform: translateX(0);
+  }
+}
+@keyframes hc-pop {
+  0% {
+    transform: scale(0.6);
+  }
+  60% {
+    transform: scale(1.14);
+  }
+  100% {
+    transform: scale(1);
+  }
+}
+@keyframes hc-stamp {
+  from {
+    opacity: 0;
+    transform: rotate(-10deg) scale(1.6);
+  }
+  to {
+    opacity: 1;
+    transform: rotate(-10deg) scale(1);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hc-slide,
+  .hc-pop,
+  .hc-stamp,
+  .hc-expand {
+    animation: none;
+  }
+  .hc-deck-card {
+    transition: none;
+  }
+}
+
 /* ─── Messagerie (design Tour 3) ──────────────────────────────────────────────
    Le panneau entre par la droite comme une pile de navigation iOS ; les bulles
    se posent une à une ; les trois points de saisie respirent en décalé. */
