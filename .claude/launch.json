{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/web && npx next dev"
      ],
      "autoPort": true,
      "port": 3001
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/mobile && npx expo start --web --port 8081"
      ],
      "port": 8081
    }
  ]
}
